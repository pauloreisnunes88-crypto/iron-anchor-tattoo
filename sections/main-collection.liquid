
<section class="collection-page">
  <div class="section-heading">
    <p class="eyebrow">THE IRON ANCHOR COLLECTION</p>
    <h1>{{ collection.title | escape }}</h1>

    {% if collection.description != blank %}
      <div class="collection-description">
        {{ collection.description }}
      </div>
    {% endif %}
  </div>

  {% paginate collection.products by section.settings.products_per_page %}
    {% if collection.products.size > 0 %}
      <div class="product-grid">
        {% for product in collection.products %}
          <article class="product-card">
            <a href="{{ product.url }}" class="product-image">
              {% if product.featured_image %}
                {{
                  product.featured_image
                  | image_url: width: 800
                  | image_tag: loading: 'lazy', alt: product.title
                }}
              {% else %}
                <div class="product-image-placeholder">
                  IRON ANCHOR
                </div>
              {% endif %}
            </a>

            <div class="product-info">
              {% if product.vendor != blank %}
                <p class="product-vendor">{{ product.vendor | escape }}</p>
              {% endif %}

              <h2>
                <a href="{{ product.url }}">
                  {{ product.title | escape }}
                </a>
              </h2>

              <p class="product-price">
                {{ product.price | money }}
              </p>

              {% if product.available %}
                <a class="button button-secondary" href="{{ product.url }}">
                  VIEW PRODUCT
                </a>
              {% else %}
                <span class="sold-out">SOLD OUT</span>
              {% endif %}
            </div>
          </article>
        {% endfor %}
      </div>

      {% if paginate.pages > 1 %}
        <nav class="pagination" aria-label="Collection pages">
          {% if paginate.previous %}
            <a href="{{ paginate.previous.url }}">← Previous</a>
          {% endif %}

          <span>Page {{ paginate.current_page }} of {{ paginate.pages }}</span>

          {% if paginate.next %}
            <a href="{{ paginate.next.url }}">Next →</a>
          {% endif %}
        </nav>
      {% endif %}
    {% else %}
      <div class="empty-state">
        <h2>THE COLLECTION IS COMING</h2>
        <p>New pieces are being prepared. Check back soon.</p>
        <a class="button" href="{{ routes.all_products_collection_url }}">
          EXPLORE THE SHOP
        </a>
      </div>
    {% endif %}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Main collection",
  "settings": [
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 4,
      "max": 24,
      "step": 4,
      "default": 12
    }
  ]
}
{% endschema %}
