
<section class="page-content">
  <div class="section-heading">
    <p class="eyebrow">IRON ANCHOR TATTOO</p>

    {% if section.settings.show_title %}
      <h1>{{ page.title | escape }}</h1>
    {% endif %}
  </div>

  <div class="page-body">
    {{ page.content }}
  </div>

  <div class="page-contact">
    <p class="eyebrow">MAKE YOUR MARK</p>
    <h2>Have a question?</h2>
    <p>Get in touch with Iron Anchor Tattoo.</p>
    <a class="button" href="{{ routes.root_url }}pages/contact">
      CONTACT US
    </a>
  </div>
</section>

{% schema %}
{
  "name": "Main page",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_title",
      "label": "Show page title",
      "default": true
    }
  ]
}
{% endschema %}
