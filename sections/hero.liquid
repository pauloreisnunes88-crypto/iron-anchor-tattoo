<section class="hero" style="--hero-image: {% if section.settings.background_image != blank %}url('{{ section.settings.background_image | image_url: width: 2000 }}'){% else %}#202024{% endif %};">
  <div class="hero-content">
    {% if section.settings.eyebrow != blank %}
      <p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>
    {% endif %}

    <h1>{{ section.settings.heading | escape }}</h1>

    {% if section.settings.description != blank %}
      <p>{{ section.settings.description | escape }}</p>
    {% endif %}

    <div class="hero-actions">
      {% if section.settings.button_label != blank %}
        <a class="button primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label | escape }}
        </a>
      {% endif %}

      {% if section.settings.secondary_button_label != blank %}
        <a class="button secondary" href="{{ section.settings.secondary_button_link | default: '#contact' }}">
          {{ section.settings.secondary_button_label | escape }}
        </a>
      {% endif %}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Iron Anchor hero",
  "tag": "section",
  "class": "iron-anchor-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small heading",
      "default": "Independent tattoo art"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main heading",
      "default": "ART THAT LEAVES A MARK"
    },
    {
      "type": "textarea",
      "id": "description",
      "label": "Description",
      "default": "Bold tattoo culture. Original artwork. Timeless attitude."
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Background image"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Primary button text",
      "default": "Explore the collection"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "secondary_button_label",
      "label": "Secondary button text",
      "default": "Book a session"
    },
    {
      "type": "url",
      "id": "secondary_button_link",
      "label": "Secondary button link"
    }
  ],
  "presets": [
    {
      "name": "Iron Anchor hero"
    }
  ]
}
{% endschema %}
